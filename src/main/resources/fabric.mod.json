{
  "schemaVersion": 1,
  "id": "justanothersbmod",
  "version": "${version}",
  "name": "JustAnotherSBMod",
  "description": "Configurable farming and mining helpers for Hypixel SkyBlock.",
  "authors": [
    "NoRhythmDEV"
  ],
  "contact": {
    "homepage": "https://github.com/NoRhythmDEV/JustAnotherSBMod",
    "sources": "https://github.com/NoRhythmDEV/JustAnotherSBMod",
    "issues": "https://github.com/NoRhythmDEV/JustAnotherSBMod/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.norhythm.justanothersbmod.JustAnotherSBModClient"
    ]
  },
  "mixins": [
    {
      "config": "justanothersbmod.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "justanothersbmod.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
